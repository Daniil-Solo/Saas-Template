# Копия этого файла в .env даёт рабочее dev-окружение в docker compose.
# Значения ниже - ТОЛЬКО для разработки. Переменные с префиксом VITE_ попадают в браузерный бандл:
# секреты в них хранить нельзя.

# docker compose: подключает dev-файл, чтобы не указывать -f в каждой команде
COMPOSE_FILE=dev.docker-compose.yml

# Адрес API для браузера. Пусто - запросы идут на тот же origin (/api/...) и проксируются Vite на backend
VITE_API_URL=

# Куда Vite dev-сервер проксирует /api. Внутри dev-network backend доступен по алиасу backend
DEV_PROXY_TARGET=http://backend:8000

# Откуда генерируется API-клиент (pnpm gen:api)
OPENAPI_URL=http://backend:8000/openapi.json
