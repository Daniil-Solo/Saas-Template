# Копия этого файла в .env даёт рабочее dev-окружение в docker compose.
# Значения ниже - ТОЛЬКО для разработки. Для любых других окружений замените все секреты.

# docker compose: подключает dev-файл, чтобы не указывать -f в каждой команде
COMPOSE_FILE=dev.docker-compose.yml

# service
APP=backend
ENV=dev

# auth
# Генерация: openssl rand -hex 32
AUTH_SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
# Время жизни access-токена, минуты (по умолчанию 60)
AUTH_ACCESS_TOKEN_TTL_MINUTES=60

# invitations
# Срок действия приглашения в организацию, дни (по умолчанию 7)
INVITATION_TTL_DAYS=7

# admin
# Если заданы оба значения, при старте создаётся администратор системы (если такого email ещё нет).
# Существующий пользователь не изменяется. Пароль - от 8 символов
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Security
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_ENCRYPTION_KEY=qr1O6f037rkE6b3TPjjAF4bf47ib9thSTmUU9ju_Vz4=

# logging
# Уровень: DEBUG|INFO|WARNING|ERROR. Формат: console (для человека) | json (по записи на строку)
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# metrics
# Метрики Prometheus на GET /api/internal/metrics (по умолчанию включены)
METRICS_ENABLED=true

# sentry
# Пусто - отправка ошибок в Sentry выключена. Окружение по умолчанию берётся из ENV
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Доля трассируемых запросов, 0..1
SENTRY_TRACES_SAMPLE_RATE=0

# grafana (dev; доступна на http://localhost:${GRAFANA_PORT}, по умолчанию 3000 - поменяйте, если порт занят)
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin


# Database (PostgreSQL). Внутри docker-сети хост - имя сервиса db.
# Пользователь обязан иметь право CREATEDB: для тестов создаётся отдельная БД
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app


# S3 (в dev - MinIO; ключи используются и как логин/пароль MinIO, пароль не короче 8 символов)
S3_ENDPOINT=http://s3:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=app
S3_USE_SSL=False


# Email
# Коннектор: console (по умолчанию; письма пишутся в лог воркера, не отправляются) | smtp | maileroo
EMAIL_BACKEND=console
EMAIL_FROM=noreply@example.com
# Имя отправителя и название сервиса в шапке письма
EMAIL_FROM_DISPLAY_NAME=App
# maileroo (нужен при EMAIL_BACKEND=maileroo)
EMAIL_MAILEROO_API_KEY=
# smtp (нужен хост при EMAIL_BACKEND=smtp; для mailpit из compose: host=mailpit, port=1025, tls=none)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TLS=starttls

# Публичный адрес приложения: из него строятся ссылки в письмах (без завершающего слеша)
APP_BASE_URL=http://localhost:5173


# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis-dev-password
