# Копия этого файла в .env даёт рабочее dev-окружение в docker compose.
# Значения ниже - ТОЛЬКО для разработки. Для любых других окружений замените все секреты.

# docker compose: подключает dev-файл, чтобы не указывать -f в каждой команде
COMPOSE_FILE=dev.docker-compose.yml

# service
APP=backend
ENV=dev

# auth
# Генерация: openssl rand -hex 32
AUTH_SECRET_KEY=dev-only-secret-key-change-me

# Security
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_ENCRYPTION_KEY=qr1O6f037rkE6b3TPjjAF4bf47ib9thSTmUU9ju_Vz4=

# logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console


# Database (PostgreSQL). Внутри docker-сети хост - имя сервиса db.
# Пользователь обязан иметь право CREATEDB: для тестов создаётся отдельная БД
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app


# S3 (в dev - MinIO; ключи используются и как логин/пароль MinIO, пароль не короче 8 символов)
S3_ENDPOINT=http://s3:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=app
S3_USE_SSL=False


# Email
EMAIL_FROM=noreply@example.com
EMAIL_FROM_DISPLAY_NAME=App
EMAIL_MAILEROO_API_KEY=...


# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis-dev-password
