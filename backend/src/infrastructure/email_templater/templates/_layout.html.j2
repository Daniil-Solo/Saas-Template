{# Каркас письма: таблицы и inline-стили, без внешнего CSS и картинок. Цвета и шрифт - переменные ниже. #}
{% set accent = "#2563eb" %}
{% set bg = "#f6f7f9" %}
{% set card_bg = "#ffffff" %}
{% set text_color = "#1f2937" %}
{% set muted = "#6b7280" %}
{% set font = "-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" %}
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{% block title %}{{ app_name }}{% endblock %}</title>
<style>
@media (prefers-color-scheme: dark) {
  .bg { background-color: #111827 !important; }
  .card { background-color: #1f2937 !important; }
  .text { color: #e5e7eb !important; }
  .muted { color: #9ca3af !important; }
}
</style>
</head>
<body class="bg" style="margin:0;padding:0;background-color:{{ bg }};">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{% block preheader %}{% endblock %}</div>
<table role="presentation" class="bg" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:{{ bg }};">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:560px;">
<tr><td style="padding:0 8px 16px;font-family:{{ font }};font-size:18px;font-weight:700;color:{{ accent }};">{{ app_name }}</td></tr>
<tr><td class="card" style="background-color:{{ card_bg }};border-radius:8px;padding:32px;font-family:{{ font }};font-size:16px;line-height:24px;color:{{ text_color }};">
<div class="text" style="color:{{ text_color }};">
{% block content %}{% endblock %}
</div>
</td></tr>
<tr><td class="muted" style="padding:16px 8px 0;font-family:{{ font }};font-size:12px;line-height:18px;color:{{ muted }};">
Это служебное письмо от {{ app_name }}. Отвечать на него не нужно.
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
