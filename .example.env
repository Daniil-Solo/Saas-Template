# Production-окружение. Копия этого файла в .env (не коммитится) используется сервером:
#   cp .example.env .env
# Замените ВСЕ значения <...>. Секреты генерируйте уникальными: openssl rand -hex 32

# docker compose: подключает production-файл, чтобы не указывать -f в каждой команде
COMPOSE_FILE=prod.docker-compose.yml

# Домен, на который указывает DNS-запись сервера (для автоматического HTTPS)
DOMAIN=<example.com>

# Адрес API для браузера. Пусто - API на том же origin (/api/...). Значение публично, секретов тут быть не должно
VITE_API_URL=

# service
APP=backend
ENV=prod

# auth
# Генерация: openssl rand -hex 32
AUTH_SECRET_KEY=<secret>

# invitations
# Срок действия приглашения в организацию, дни (по умолчанию 7)
INVITATION_TTL_DAYS=7

# admin
# Если заданы оба значения, при старте создаётся администратор системы (если такого email ещё нет).
# Существующий пользователь не изменяется. Пароль - от 8 символов
ADMIN_EMAIL=<admin@example.com>
ADMIN_PASSWORD=<secret>

# Security
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_ENCRYPTION_KEY=<fernet-key>

# logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# metrics
# Метрики Prometheus на GET /api/internal/metrics (наружу закрыто Caddy; по умолчанию включены)
METRICS_ENABLED=true

# sentry (backend)
# Пусто - отправка ошибок в Sentry выключена. Окружение по умолчанию берётся из ENV
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Доля трассируемых запросов, 0..1
SENTRY_TRACES_SAMPLE_RATE=0

# sentry (frontend; значения попадают в публичный бандл, пустой DSN - выключено)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_APP_RELEASE=

# grafana (доступна на https://grafana.<DOMAIN>, нужна DNS-запись grafana.<DOMAIN>)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<secret>

# Database (PostgreSQL). Внутри docker-сети хост - имя сервиса db
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=<secret>
DB_NAME=app

# S3 (MinIO внутри docker-сети; ключи используются и как логин/пароль MinIO, пароль не короче 8 символов)
S3_ENDPOINT=http://s3:9000
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret>
S3_BUCKET=app
S3_USE_SSL=False

# Email
# Коннектор: console (письма пишутся в лог, не отправляются) | smtp | maileroo. На проде задайте smtp или maileroo
EMAIL_BACKEND=maileroo
EMAIL_FROM=<noreply@example.com>
EMAIL_FROM_DISPLAY_NAME=App
# maileroo
EMAIL_MAILEROO_API_KEY=<api-key>
# smtp (логин и пароль необязательны, но только парой; EMAIL_SMTP_TLS=starttls|ssl|none)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TLS=starttls

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<secret>
